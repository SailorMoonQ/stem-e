<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS transport profile for an operator workstation.

  Copy to fastdds_desktop.xml and replace the example address with the real IPv4
  address of this machine's physical network interface. The copy is gitignored.

  Same reasoning as the robot profile: keep shared memory for anything running
  locally, and pin UDP to the physical interface so DDS never binds to a VPN or
  proxy TUN device. On a workstation running a proxy client this is not optional.
  Without it, discovery traffic leaves through the tunnel and the robot never
  appears in the graph.

  Note on Fast DDS versions: this targets Fast DDS 2.x as shipped with ROS 2 Jazzy.
  Fast DDS 3.x renames <interfaceWhiteList> to <interfaces><allowlist>.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>

    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_transport</transport_id>
        <type>SHM</type>
      </transport_descriptor>

      <transport_descriptor>
        <transport_id>udp_physical_only</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <!-- TODO: replace with the workstation's physical interface address. -->
          <address>192.168.1.20</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="stem_desktop_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_transport</transport_id>
          <transport_id>udp_physical_only</transport_id>
        </userTransports>
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>

  </profiles>
</dds>
