<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Fast DDS transport profile for the STEM-E onboard computer.

  Copy to fastdds_robot.xml and replace the example address with the real IPv4
  address of this machine's physical network interface. The copy is gitignored.

  Two jobs:

    1. Keep the shared memory transport, so the onboard ROS graph never touches a
       network interface. This is what keeps the 500 Hz control path off WiFi.
    2. Restrict UDP to the physical interface, so DDS cannot bind to a VPN or proxy
       TUN device, a docker bridge, or any other virtual adapter. Without the
       whitelist, Fast DDS enumerates every interface it can see and will happily
       advertise unreachable addresses.

  Note on Fast DDS versions: this targets Fast DDS 2.x as shipped with ROS 2 Jazzy.
  Fast DDS 3.x renames <interfaceWhiteList> to <interfaces><allowlist>.
-->
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <profiles>

    <transport_descriptors>
      <transport_descriptor>
        <transport_id>shm_transport</transport_id>
        <type>SHM</type>
      </transport_descriptor>

      <transport_descriptor>
        <transport_id>udp_physical_only</transport_id>
        <type>UDPv4</type>
        <interfaceWhiteList>
          <!-- TODO: replace with the robot's physical interface address. -->
          <address>192.168.1.10</address>
        </interfaceWhiteList>
      </transport_descriptor>
    </transport_descriptors>

    <participant profile_name="stem_robot_participant" is_default_profile="true">
      <rtps>
        <userTransports>
          <transport_id>shm_transport</transport_id>
          <transport_id>udp_physical_only</transport_id>
        </userTransports>
        <!--
          Builtin transports are disabled so that the whitelisted UDP descriptor above
          is the only UDP path. Leaving them enabled silently reintroduces every
          interface, including the TUN device.
        -->
        <useBuiltinTransports>false</useBuiltinTransports>
      </rtps>
    </participant>

  </profiles>
</dds>
