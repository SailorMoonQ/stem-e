# Environment for an operator workstation.
#
# Copy to desktop.env, edit the addresses, then source it. The copy is gitignored;
# this repository is public, so no real addresses belong in the example.
#
#   cp config/env/desktop.env.example config/env/desktop.env
#   source config/env/desktop.env

export STEM_WS="${STEM_WS:-$HOME/stem-e}"

# Must match the robot.
export ROS_DOMAIN_ID=42

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

export FASTRTPS_DEFAULT_PROFILES_FILE="${STEM_WS}/config/middleware/fastdds_desktop.xml"
export FASTDDS_DEFAULT_PROFILES_FILE="${FASTRTPS_DEFAULT_PROFILES_FILE}"

# Point at the discovery server running on the robot.
# TODO: replace with the robot's real address.
export ROS_DISCOVERY_SERVER=192.168.1.10:11811

# Required on every machine that runs CLI or introspection tools.
#
# With a discovery server, a plain client only learns about endpoints it has been
# matched with. `ros2 topic list`, `ros2 node list`, rqt and rviz2 will all show a
# partial graph unless the process is a super client. This is the single most common
# way to lose an afternoon to a discovery server setup.
export ROS_SUPER_CLIENT=true

# NAS mount used for rosbag playback and datasets. Read only from here.
# TODO: replace with the real mount point.
export STEM_BAG_ARCHIVE="/mnt/nas/rosbags"
