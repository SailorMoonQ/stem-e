# Environment for the STEM-E onboard computer.
#
# Copy to robot.env, edit the addresses, then source it. The copy is gitignored;
# this repository is public, so no real addresses belong in the example.
#
#   cp config/env/robot.env.example config/env/robot.env
#   source config/env/robot.env

# Repository root. Everything else is resolved relative to this.
export STEM_WS="${STEM_WS:-$HOME/stem-e}"

# Domain isolation. Any value in 0..101 works; pick one and keep every machine on it.
export ROS_DOMAIN_ID=42

export RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Transport profile: shared memory onboard, UDP pinned to the physical interface.
# Both variable names are set because the spelling changed between Fast DDS versions.
export FASTRTPS_DEFAULT_PROFILES_FILE="${STEM_WS}/config/middleware/fastdds_robot.xml"
export FASTDDS_DEFAULT_PROFILES_FILE="${FASTRTPS_DEFAULT_PROFILES_FILE}"

# Unicast discovery. The discovery server runs on this machine, because the robot is
# the one node that is always up. Start it with:
#
#   fastdds discovery --server-id 0 --ip-address <robot ip> --port 11811
#
# TODO: replace with the robot's real address.
export ROS_DISCOVERY_SERVER=192.168.1.10:11811

# Where rosbags land. Local storage only: see docs/adr/0005 and tools/rosbag/.
export STEM_BAG_DIR="/data/rosbags"
